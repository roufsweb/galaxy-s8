# ========================================================
# Galaxy S8 Native Linux & Docker Project .gitignore
# ========================================================

# Credentials, tokens, and private secrets
.env*
*.token
*.key
*.pem
*.secret
auth*.json
credentials*.json
id_rsa*
id_ed25519*

# Large firmware images, partition dumps, and Odin archives
*.tar
*.tar.md5
*.tar.gz
*.tar.xz
*.tar.bz2
*.img
*.img.gz
*.img.lz4
*.lz4
*.cpio
*.bin
*.iso
*.zip
*.pdf
*.hcd
*.fw
*.blob
releases/
tools/
dist/
build/
*.spec

# Audio recordings & test media
*.wav
*.mp3
*.mp4

# Firmware directories & raw partitions
device_firmware/
galaxy-s8-stock-firmwire/
AP_G950NKSU5DVG2_*/
meta-data/
archive/
.archive/

# Kernel source tree (tracked independently)
galaxy-s8-kvm-kernel/

# Compiled chroot test binaries & shared libraries
*.so
*.so.*
/echo
/echo_arm64
/strace
/twrp_adbd

# Scratch development directory
scratch/
last_kmsg*

# OS & Editor transients
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/
*.py[cod]
.vscode/
.idea/
