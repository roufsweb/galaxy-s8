[Unit]
Description=Galaxy S8 USB ConfigFS RNDIS Ethernet Gadget & DHCP
DefaultDependencies=no
After=sys-kernel-config.mount local-fs.target
Wants=sys-kernel-config.mount
Before=network-pre.target

[Service]
Type=simple
SupplementaryGroups=aid_inet aid_net_raw aid_net_admin
TimeoutStopSec=5
ExecStart=/usr/local/bin/s8-usb-gadget.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

