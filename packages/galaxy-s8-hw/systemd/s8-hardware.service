[Unit]
Description=Galaxy S8 Exynos 8895 Hardware Init (PMIC 1500mA, ZRAM, ALSA, V4L2 Guard)
DefaultDependencies=no
After=systemd-udevd.service local-fs.target
Before=network-pre.target NetworkManager.service docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/s8-hardware-init.sh

[Install]
WantedBy=multi-user.target

